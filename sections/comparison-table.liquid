{{ 'section-comparison-table.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign widths = '44, 50, 375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
-%}
<comparison-table class="section-comparison-table">
    <div class="page-width">
        <div class="section-comparison-table-header">
            {% if section.settings.heading_before != blank
                or section.settings.heading_image != blank
                or section.settings.heading_after != blank %}
                <h2 class="comparison-table-title">
                    {% if section.settings.heading_before != blank %}
                        <span>{{ section.settings.heading_before }}</span>
                    {% endif %}
                    {% if section.settings.heading_image != blank %}
                        {{ section.settings.heading_image | image_url: width: 200 | image_tag: widths: widths, loading: 'lazy', class: 'comparison-table-title-image' }}
                    {% endif %}
                    {% if section.settings.heading_after != blank %}
                        <span>{{ section.settings.heading_after }}</span>
                    {% endif %}
                </h2>
            {% endif %}

            {% if section.settings.description != blank %}
                <div class="comparison-description">
                    {{ section.settings.description }}
                </div>
            {% endif %}
        </div>
        <div class="section-comparison-table-wrap">
            <div class="swiper comparison-swiper">
                <div class="swiper-wrapper">
                    <div class="swiper-slide">
                        <div class="comparison-card active">
                            <div class="comparison-card-head">
                                {% if section.settings.left_title != blank %}
                                    <h3 class="comparison-card--title">{{ section.settings.left_title }}</h3>
                                {% endif %}
                                {% if section.settings.left_subtitle != blank %}
                                    <p class="comparison-card--subtitle">{{ section.settings.left_subtitle | newline_to_br }}</p>
                                {% endif %}
                            </div>
                            {% for block in section.blocks %}
                                <div class="comparison-row">
                                    <div class="comparison-row-text">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M16.1475 9.3525C16.2528 9.45797 16.312 9.60094 16.312 9.75C16.312 9.89906 16.2528 10.042 16.1475 10.1475L10.8975 15.3975C10.792 15.5028 10.6491 15.562 10.5 15.562C10.3509 15.562 10.208 15.5028 10.1025 15.3975L7.8525 13.1475C7.75314 13.0409 7.69905 12.8998 7.70162 12.7541C7.70419 12.6084 7.76323 12.4693 7.86629 12.3663C7.96935 12.2632 8.10839 12.2042 8.25411 12.2016C8.39984 12.199 8.54087 12.2531 8.6475 12.3525L10.5 14.2041L15.3525 9.3525C15.458 9.24716 15.6009 9.18799 15.75 9.18799C15.8991 9.18799 16.042 9.24716 16.1475 9.3525ZM21.5625 12C21.5625 13.8913 21.0017 15.7401 19.9509 17.3126C18.9002 18.8852 17.4067 20.1108 15.6594 20.8346C13.9121 21.5584 11.9894 21.7477 10.1345 21.3788C8.27951 21.0098 6.57564 20.099 5.2383 18.7617C3.90096 17.4244 2.99022 15.7205 2.62125 13.8656C2.25227 12.0106 2.44164 10.0879 3.16541 8.34059C3.88917 6.59327 5.11482 5.09981 6.68736 4.04907C8.25991 2.99833 10.1087 2.4375 12 2.4375C14.5352 2.44048 16.9658 3.44891 18.7584 5.24158C20.5511 7.03425 21.5595 9.46478 21.5625 12ZM20.4375 12C20.4375 10.3312 19.9427 8.69992 19.0155 7.31238C18.0884 5.92484 16.7706 4.84338 15.2289 4.20477C13.6871 3.56615 11.9906 3.39906 10.3539 3.72462C8.71722 4.05019 7.2138 4.85378 6.03379 6.03379C4.85379 7.21379 4.05019 8.71721 3.72463 10.3539C3.39907 11.9906 3.56616 13.6871 4.20477 15.2289C4.84338 16.7706 5.92484 18.0884 7.31238 19.0155C8.69992 19.9426 10.3312 20.4375 12 20.4375C14.237 20.435 16.3817 19.5453 17.9635 17.9635C19.5453 16.3817 20.435 14.237 20.4375 12Z" fill="#12946E"/></svg>
                                        <span>{{ block.settings.left_text }}</span>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                    <div class="swiper-slide">
                        <div class="comparison-card">
                            <div class="comparison-card-head">
                                {% if section.settings.right_title != blank %}
                                    <h3 class="comparison-card--title">{{ section.settings.right_title }}</h3>
                                {% endif %}
                                {% if section.settings.right_subtitle != blank %}
                                    <p class="comparison-card--subtitle">{{ section.settings.right_subtitle | newline_to_br }}</p>
                                {% endif %}
                            </div>

                            {% for block in section.blocks %}
                                <div class="comparison-row">
                                    <div class="comparison-row-text">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                            <path d="M15.3975 9.3975L12.795 12L15.3975 14.6025C15.4528 14.654 15.4971 14.7161 15.5278 14.7851C15.5586 14.8541 15.5751 14.9286 15.5764 15.0041C15.5778 15.0796 15.5639 15.1547 15.5356 15.2247C15.5073 15.2947 15.4652 15.3584 15.4118 15.4118C15.3584 15.4652 15.2947 15.5073 15.2247 15.5356C15.1547 15.5639 15.0796 15.5778 15.0041 15.5764C14.9286 15.5751 14.8541 15.5586 14.7851 15.5278C14.7161 15.4971 14.654 15.4528 14.6025 15.3975L12 12.795L9.3975 15.3975C9.29087 15.4969 9.14983 15.551 9.00411 15.5484C8.85838 15.5458 8.71934 15.4868 8.61628 15.3837C8.51322 15.2807 8.45419 15.1416 8.45162 14.9959C8.44904 14.8502 8.50314 14.7091 8.6025 14.6025L11.205 12L8.6025 9.3975C8.50314 9.29087 8.44904 9.14983 8.45162 9.00411C8.45419 8.85838 8.51322 8.71934 8.61628 8.61628C8.71934 8.51322 8.85838 8.45419 9.00411 8.45162C9.14983 8.44905 9.29087 8.50314 9.3975 8.6025L12 11.205L14.6025 8.6025C14.7091 8.50314 14.8502 8.44905 14.9959 8.45162C15.1416 8.45419 15.2807 8.51322 15.3837 8.61628C15.4868 8.71934 15.5458 8.85838 15.5484 9.00411C15.5509 9.14983 15.4969 9.29087 15.3975 9.3975ZM21.5625 12C21.5625 13.8913 21.0017 15.7401 19.9509 17.3126C18.9002 18.8852 17.4067 20.1108 15.6594 20.8346C13.9121 21.5584 11.9894 21.7477 10.1344 21.3788C8.2795 21.0098 6.57563 20.099 5.23829 18.7617C3.90095 17.4244 2.99021 15.7205 2.62124 13.8656C2.25227 12.0106 2.44164 10.0879 3.1654 8.34059C3.88916 6.59327 5.11481 5.09981 6.68736 4.04907C8.2599 2.99833 10.1087 2.4375 12 2.4375C14.5352 2.44048 16.9657 3.44891 18.7584 5.24158C20.5511 7.03425 21.5595 9.46478 21.5625 12ZM20.4375 12C20.4375 10.3312 19.9426 8.69992 19.0155 7.31238C18.0884 5.92484 16.7706 4.84338 15.2289 4.20477C13.6871 3.56615 11.9906 3.39906 10.3539 3.72462C8.71721 4.05019 7.21379 4.85378 6.03378 6.03379C4.85378 7.21379 4.05018 8.71721 3.72462 10.3539C3.39906 11.9906 3.56615 13.6871 4.20476 15.2289C4.84338 16.7706 5.92483 18.0884 7.31237 19.0155C8.69991 19.9426 10.3312 20.4375 12 20.4375C14.237 20.435 16.3817 19.5453 17.9635 17.9635C19.5453 16.3817 20.435 14.237 20.4375 12Z" fill="#8F8F8F"/>
                                        </svg>
                                        <span>{{ block.settings.right_text }}</span>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
                <div class="swiper-pagination comparison-pagination"></div>
            </div>
        </div>
    </div>
</comparison-table>

<script src="{{ 'comparison-table.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Comparison Table",
  "settings": [
    {
        "type": "text",
        "id": "heading_before",
        "label": "Heading First Part"
    },
    {
        "type": "image_picker",
        "id": "heading_image",
        "label": "Heading Center Image",
        "info":"100X50 .png / .svg"
    },
    {
        "type": "text",
        "id": "heading_after",
        "label": "Heading Last Part"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "left_title",
      "label": "Left Title"
    },
    {
      "type": "textarea",
      "id": "left_subtitle",
      "label": "Left Subtitle"
    },
    {
      "type": "text",
      "id": "right_title",
      "label": "Right Title"
    },
    {
      "type": "textarea",
      "id": "right_subtitle",
      "label": "Right Subtitle"
    }
  ],
  "blocks": [
    {
      "type": "comparison_row",
      "name": "Comparison Row",
      "settings": [
        {
          "type": "text",
          "id": "left_text",
          "label": "Left Text"
        },
        {
          "type": "text",
          "id": "right_text",
          "label": "Right Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison Table"
    }
  ]
}
{% endschema %}