                            <span class="c_price">Valor de hasta <span data-price></span></span>
                          </div>
                        </div>
                        <div class="benefits_block-desc rte">
                          {{ block.settings.benefits_text }}
                        </div>
                      </div>
                    {% endif %}

                    <div class="gift-box-popup">
                      <div class="gift-box-popup-btn d-flex center-center" id="gift-box-popup-btn">
