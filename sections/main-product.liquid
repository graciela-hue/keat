                          <div class="subscription-widget-tooltip-text">
                            <div class="rte">
                              {{ block.settings.info_text }}
                            </div>
                          </div>
                      </div>
                      {{ block.settings.info_head }}
                    </div>
                  </div>
                  {% endif %}

                  <div class="benefits-and-gift-box hidden" id="benefits-and-gift-box">
