                    </div>
                  {%- endfor -%}
                  </div>
                {% else %}
                  {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
                {% endif %}

                {% if product.metafields.custom.producto_con_seleccion_de_fecha %}
                  {% assign index_count_date = 1 %}
                  {% assign index_count_day = 2 %}
                  {%- unless product.has_only_default_variant -%}
                    {% assign index_count_date = product.options_with_values.size | plus: 1 %}
                    {% assign index_count_day = product.options_with_values.size | plus: 2 %}
                  {% endunless %}

                  {% assign has_calendar = product.metafields.custom.tiene_fechas_calendario %}
                  {% assign is_group = product.metafields.custom.es_grupal %}
                  <div id="ProductDateBuilder" class="product-dates-wrap" data-handle="{{ product.handle }}" {% if has_calendar %} data-calendario="true" data-fechas-calendario="true"{% endif %}>
                    {% if has_calendar %}
                    <div class="product-date-block">
                      <p class="product-date-field_label d-flex m-0"><span class="number d-flex center-center">{{ index_count_date }}</span> Selecciona fecha de Inicio: <span data-value></span></p>
                      <input type="hidden" id="fecha-inicio-campo" name="properties[Fecha de Inicio]" value="" form="{{ product_form_id }}">

                      <div class="product-date-block-inputs group-of-dates" id="calendar_dates">
                        {%- assign today = 'now' | date: '%s' -%}
                        {%- assign min_days = product.metafields.custom.dias_minimos_para_fechas_en_calendario | default: 0 -%}
                        {%- assign min_seconds = min_days | times: 86400 -%}
                        
                        {%- assign index = 0 -%}
                        {%- for date in product.metafields.custom.fechas_calendario.value -%}
                          {%- assign date_ts = date | date: '%s' -%}
                          {%- assign diff = date_ts | minus: today -%}
                          {%- if diff >= min_seconds and diff <= 7776000 -%}
                            {%- assign index = index | plus: 1 -%}
                            {%- render 'translate-date', date: date , index: index -%}
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </div>

                    {% comment %} DELIVERY SLOTS {% endcomment %}
                    <div class="product-date-block">
                      <p class="product-date-field_label d-flex m-0"><span class="number d-flex center-center">{{ index_count_day }}</span> Selecciona turno de entrega: <span data-value></span></p>
                      <input type="hidden" id="turno-entrega-campo" name="properties[Turno de entrega]" value="" form="{{ product_form_id }}">
                      <div class="product-date-block-inputs" id="calendar_slots">
                        {%- if product.metafields.custom.turnos_de_entrega.value != blank -%}
                          {%- for turno in product.metafields.custom.turnos_de_entrega.value -%}
                            <input type="radio" name="properties[Turno de entrega]" id="day-{{ turno | handle }}" value="{{ turno }}"{% if forloop.first %} checked{% endif %}>
                            <label for="day-{{ turno | handle }}">{{ turno }}</label>
                          {%- endfor -%}
                        {%- else -%}
                          <input type="radio" name="properties[Turno de entrega]" id="Cada-noche-anterior-6-9pm" value="Cada noche anterior 6:00-9:00pm" checked>
                          <label for="Cada-noche-anterior-6-9pm">Cada noche anterior 6:00-9:00pm</label>
                          <input type="radio" name="properties[Turno de entrega]" id="Cada-mañana-7-9am" value="Cada mañana 7:00-9:00am">
                          <label for="Cada-mañana-7-9am">Cada mañana 7:00-9:00am</label>
                        {%- endif -%}
                      </div>
                    </div>

                    {% comment %} -------------------------------
                      MODE 2: GROUP
                      -------------------------------- {% endcomment %}
                    {% elsif is_group %}
                      <div class="product-date-block">
                        <p class="product-date-field_label d-flex m-0"><span class="number d-flex center-center">{{ index_count_date }}</span> Selecciona fecha de Inicio: <span data-value></span></p>
                        <input type="hidden" id="fecha-inicio-campo" name="properties[Fecha de Inicio]" value="" form="{{ product_form_id }}">
                        <div class="product-date-block-inputs group-of-dates" id="group_start_dates">
                          {% for date in product.metafields.custom.fecha_de_inicio_grupal.value %}
                            {% render 'translate-date', date: date , index: forloop.index %}
                          {% endfor %}
                        </div>
                      </div>

                      <div class="product-date-block">
                        <p class="product-date-field_label d-flex m-0"><span class="number d-flex center-center">{{ index_count_day }}</span> Selecciona turno de entrega: <span data-value></span></p>
                        <input type="hidden" id="turno-entrega-campo" name="properties[Turno de entrega]" value="" form="{{ product_form_id }}">
                        <div class="product-date-block-inputs" id="group_delivery">
                          {% for item in product.metafields.custom.fechas_de_entrega_grupal.value %}
                            <input type="radio" name="properties[Turno de entrega]" id="day-{{ item | handle }}" value="{{ item }}"{% if forloop.first %} checked{% endif %}>
                            <label for="day-{{ item | handle }}">{{ item }}</label>
                          {% endfor %}
                        </div>
                      </div>
                        
                      {% comment %} -------------------------------
                        MODE 3: NORMAL
                        -------------------------------- {% endcomment %}
                    {% else %}
                      <div class="product-date-block">
                        <p class="product-date-field_label d-flex m-0"><span class="number d-flex center-center">{{ index_count_date }}</span> Selecciona fecha de Inicio: <span data-value></span></p>
                        <input type="hidden" id="fecha-inicio-campo" name="properties[Fecha de Inicio]" value="" form="{{ product_form_id }}">
                        <div class="product-date-block-inputs group-of-dates" id="normal_dates">
                          {% for date in product.metafields.custom.fecha_de_entrega.value %}
                            {% render 'translate-date', date: date , index: forloop.index %}
                          {% endfor %}
                        </div>
                      </div>

                      <div class="product-date-block">
                        <p class="product-date-field_label d-flex m-0"><span class="number d-flex center-center">{{ index_count_day }}</span> Selecciona turno de entrega: <span data-value></span></p>
                        <input type="hidden" id="turno-entrega-campo" name="properties[Turno de entrega]" value="" form="{{ product_form_id }}">
                        <div class="product-date-block-inputs" id="normal_slots">
                          {% if product.metafields.custom.turnos_de_entrega.value != blank %}
                            {% for turno in product.metafields.custom.turnos_de_entrega.value %}
                              <input type="radio" name="properties[Turno de entrega]" id="day-{{ turno | handle }}" value="{{ turno }}"{% if forloop.first %} checked{% endif %}>
                              <label for="day-{{ turno | handle }}">{{ turno }}</label>
                            {% endfor %}
                          {% else %}
                            <input type="radio" name="properties[Turno de entrega]" id="Cada-noche-anterior-6-9pm" value="Cada noche anterior 6:00-9:00pm" checked>
                            <label for="Cada-noche-anterior-6-9pm">Cada noche anterior 6:00-9:00pm</label>
                            <input type="radio" name="properties[Turno de entrega]" id="Cada-mañana-7-9am" value="Cada mañana 7:00-9:00am">
                            <label for="Cada-mañana-7-9am">Cada mañana 7:00-9:00am</label>
                          {% endif %}
                        </div>
                      </div>
                    {% endif %}
                  </div>
                {% endif %}

              {%- when 'subscription' -%}
                {% if product.selling_plan_groups.size > 0 %}
