              {%- when 'program_contents' -%}
                {% if product.metafields.custom.program_contents.value != blank %}
                  {% assign total_current_price = 0 %}
                  {% assign total_compare_price = 0 %}

                  {% capture program_rows %}
                    {% for item in product.metafields.custom.program_contents.value %}

                      {% if item.current_price != blank %}
                        {% assign total_current_price = total_current_price | plus: item.current_price %}
                      {% endif %}

                      {% if item.compare_price != blank %}
                        {% assign total_compare_price = total_compare_price | plus: item.compare_price %}
                      {% endif %}

                      <div class="program_contents-row d-flex">
                        <div class="block-media d-flex{% if item.video != blank %} has_video{% endif %}">
                          {% if item.video != blank %}
                            {{ item.video.value.preview_image.src | image_url: width: 48, height: 48 | image_tag }}
                            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="20" fill="#FEFEFF"></circle><path d="M28.2913 19.9998L15.0963 27.6179L15.0963 12.3817L28.2913 19.9998Z" fill="#12946E"></path></svg>
                            <script type="text/template" class="data-video-template">
                              {% if item.title != blank %}<h3 class="modal-title m-0">{{ item.title }}</h3>{% endif %}
                              <div class="media-block d-flex">
                                {{ item.video.value | video_tag: autoplay: false, image_size: '500x', loop: true, muted: false, controls: false, playsinline: false, preload: 'auto' }}
                                <span class="video-play"><svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="20" fill="#FEFEFF"></circle><path d="M28.2913 19.9998L15.0963 27.6179L15.0963 12.3817L28.2913 19.9998Z" fill="#12946E"></path></svg></span>
                              </div>
                            </script>
                          {% else %}
                            {{ item.image | image_url: width: 48, height: 48 | image_tag }}
                          {% endif %}
                        </div>
                        <div class="block-content">
                          {% if item.title != blank %}<h4 class="block-title m-0">{{ item.title }}</h4>{% endif %}
                          {% if item.description != blank %}<div class="block-text rte">{{ item.description }}</div>{% endif %}
                        </div>
                        <div class="block-price d-flex">
                          {% if item.current_price != blank %}
                          <span class="r_price">Ahora <span>{{ item.current_price | times:100 | money_without_trailing_zeros | replace: ' ','' }}</span></span>
                          {% elsif item.current_price_text != blank %}
                            <span class="r_price">{{ item.current_price_text }}</span>
                          {% endif %}
                          {% if item.compare_price != blank %}
                          <span class="c_price">Valor <span>{{ item.compare_price | times:100 | money_without_trailing_zeros | replace: ' ','' }}</span></span>
                          {% endif %}
                        </div>
                      </div>

                    {% endfor %}
                  {% endcapture %}
                <div class="program_contents" id="program_contents">
