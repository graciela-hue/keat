{{ 'section-featured-text.css' | asset_url | stylesheet_tag }}
{% style %}
  .section-featured-text--{{ section.id }}{
    background-color: {{ section.settings.bg_color }} !important;
    --divider-color: {{ section.settings.divider_color }};
  }
{% endstyle %}
<div class="section-featured-text section-featured-text--{{ section.id }}">
    <div class="page-width">
        <div class="featured-text-grid">

            {% for block in section.blocks %}
                <div class="featured-text-item" {{ block.shopify_attributes }}>

                <div class="featured-content">
                    {% if block.settings.number != blank %}
                        <h3 class="featured-number">
                            {{ block.settings.number }}
                        </h3>
                    {% endif %}   
                    {% if block.settings.text != blank %} 
                        <div class="featured-label">
                            {{ block.settings.text }}
                        </div>
                    {% endif %}   
                </div>

                </div>
            {% endfor %}

        </div>
    </div>
</div>
{% schema %}
{
  "name": "Featured Stats",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f3f3f3"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider Color",
      "default": "#C78C30"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "+25"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "años perfeccionando el método"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Stats",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "number": "+25",
            "text": "años perfeccionando el método"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "XX%",
            "text": "reporta mejor bienestar digestivo"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "+4,000",
            "text": "vidas transformadas"
          }
        }
      ]
    }
  ]
}
{% endschema %}