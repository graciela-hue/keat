<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{{ 'component-card.css' | asset_url | stylesheet_tag  }}
{{ 'section-product-list-slider.css' | asset_url | stylesheet_tag  }}
<product-list-slider class="section-product-list-slider section-product-list-slider--{{ section.id }}">
    <div class="page-width">
        <div class="section-product-list-slider-header">
            {% if section.settings.heading != blank %}
                <h2 class="product-list-slider-title">
                    {{ section.settings.heading }}
                </h2>
            {% endif %}  
            {% if section.settings.desc != blank %}
                <div class="product-list-slider-subtitle">
                    {{ section.settings.desc }}
                </div>
            {% endif %} 
        </div>
        <div class="product-list_wrap">
            {% assign products = section.settings.products %}
            <div class="swiper product-list-slider">
                <div class="swiper-wrapper">
                    {% for product in products limit: 8  %}
                        {% if product %}
                            <div class="swiper-slide">
                                {% render 'card-product', card_product: product, quick_add: 'standard', %}
                            </div>
                        {% endif %}
                    {% endfor %}
                </div> 
                <div class="swiper-button swiper-button-prev product-list-slider-arrow mobile_hide">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40" fill="none">
                        <rect width="40" height="40" rx="20" fill="#F7F7F7"/>
                        <path d="M15.1025 19.6025L22.6025 12.1025C22.7091 12.0031 22.8502 11.949 22.9959 11.9516C23.1416 11.9542 23.2806 12.0132 23.3837 12.1163C23.4868 12.2193 23.5458 12.3584 23.5484 12.5041C23.5509 12.6498 23.4969 12.7909 23.3975 12.8975L16.2959 20L23.3975 27.1025C23.4969 27.2091 23.5509 27.3502 23.5484 27.4959C23.5458 27.6416 23.4868 27.7806 23.3837 27.8837C23.2806 27.9868 23.1416 28.0458 22.9959 28.0484C22.8502 28.0509 22.7091 27.9969 22.6025 27.8975L15.1025 20.3975C14.9972 20.292 14.938 20.1491 14.938 20C14.938 19.8509 14.9972 19.708 15.1025 19.6025Z" fill="black"/>
                    </svg>
                </div>
                <div class="swiper-button swiper-button-next product-list-slider-arrow mobile_hide">
                    <svg width="41" height="41" viewBox="0 0 41 41" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="40.1089" y="39.9999" width="40" height="40" rx="20" transform="rotate(179.844 40.1089 39.9999)" fill="#F7F7F7"/>
                        <path d="M24.9531 20.4386L17.4735 27.959C17.3672 28.0587 17.2263 28.1131 17.0806 28.111C16.9348 28.1088 16.7956 28.0501 16.6923 27.9474C16.589 27.8446 16.5295 27.7057 16.5266 27.56C16.5236 27.4143 16.5773 27.2731 16.6764 27.1662L23.7586 20.0444L16.6377 12.9612C16.538 12.8549 16.4836 12.714 16.4857 12.5683C16.4879 12.4225 16.5466 12.2833 16.6493 12.18C16.7521 12.0766 16.891 12.0172 17.0367 12.0143C17.1824 12.0113 17.3236 12.065 17.4305 12.1641L24.9509 19.6436C25.0565 19.7488 25.1161 19.8916 25.1165 20.0407C25.1169 20.1897 25.0581 20.3329 24.9531 20.4386Z" fill="black"/>
                    </svg>
                </div>
                <div class="swiper-pagination product-list-slider-pagination desktop_hide"></div>
            </div>
        </div>
    </div>
</product-list-slider>
<script src="{{ 'product-list-slider.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Product list slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "desc",
      "label": "Desc"
    },
    {
        "type": "product_list",
        "id": "products",
        "label": "Products",
    },
  ],
  "presets": [
    {
      "name": "Product list slider"
    }
  ]
}
{% endschema %}